# KingAI v2 — Environment Configuration
# Copy to .env and fill in your values
# Keys use the `KINGAI_` prefix, matching config/__init__.py.

# Exchange
KINGAI_EXCHANGE=mt5
KINGAI_EXCHANGE_API_KEY=
KINGAI_EXCHANGE_API_SECRET=
KINGAI_EXCHANGE_PASSWORD=
KINGAI_EXCHANGE_SANDBOX=false # Bybit: true selects Demo Trading API (not testnet); public market data stays on mainnet
# CCXT only (binance, bybit, ...): spot for balances or swap for linear perpetuals
KINGAI_EXCHANGE_TYPE=spot

# MT5 transport: MCP bridge (Fedora) -> Mac agent -> MQL5 EA
KINGAI_MT5_TRANSPORT=mcp
KINGAI_MT5_MCP_URL=http://127.0.0.1:8765
KINGAI_MT5_MCP_TIMEOUT=30

# Telegram
KINGAI_TELEGRAM_BOT_TOKEN=
KINGAI_TELEGRAM_CHAT_IDS=
KINGAI_TELEGRAM_ADMIN_IDS=
#
# Telegram is OPTIONAL for the demo canary (2026-11-12 operator decision).
# Set to `true` before any real-account run: startup then refuses without a token.
KINGAI_TELEGRAM_REQUIRED=false

# LLM
KINGAI_LLM_ENABLED=true
KINGAI_LLM_PROVIDER=openrouter
KINGAI_LLM_API_KEY=
KINGAI_LLM_BASE_URL=http://100.104.99.26:20128/v1
KINGAI_LLM_MODEL=ag/gemini-3.8-flash
KINGAI_LLM_REASONING_EFFORT=medium
# Judge timeout (now actually parsed by config). The client splits this across
# 2 attempts (each ~45% of the budget). Measured 2026-11-13 on the 5.1k-char
# judge prompt: warm 7.85s, cold 89.5s. 60s gives each attempt ~27s, which
# covers warm calls; a cold call fails closed and the next setup retries warm.
KINGAI_LLM_TIMEOUT=60
# Open circuit after 3 consecutive judge errors; retry after 120s.
KINGAI_JUDGE_BREAKER_FAILURE_THRESHOLD=3
KINGAI_JUDGE_BREAKER_COOLDOWN_SECONDS=120

# Trading
KINGAI_SYMBOLS=XAUUSD,EURUSD,USDJPY
KINGAI_TIMEFRAMES=15m,1h
KINGAI_SCAN_INTERVAL=30
KINGAI_MAX_RISK_PCT=0.5
KINGAI_MAX_DAILY_LOSS_PCT=3.0
# RISK ORDER 2026-11-13: the B9 strategy gate FAILED (scalp_5m PF 0.576 on
# verified data; every tested rule loses after cost). Live-demo orders are
# halted until a strategy passes the pre-registered gate in
# docs/strategy-research.md. Recorded in docs/canary-evidence-log.md.
KINGAI_PAPER_TRADING=false
KINGAI_HEADLESS=true
KINGAI_DEBUG=false
KINGAI_LOG_LEVEL=INFO

# Agents
KINGAI_PERSONAS=trader,risk_manager,judge

# SystemOne (optional)
KINGAI_SYSTEMONE_ENABLED=false
KINGAI_SYSTEMONE_ENDPOINT=
KINGAI_SYSTEMONE_API_KEY=
MT5_CLIENT_TOKEN=

# Phase 3 live-demo canary (2026-11-12)
# Global cap counts every open position across all symbols.
KINGAI_MAX_CONCURRENT_POSITIONS=100
# Stacked positions allowed per symbol (1..100). Each entry is still 0.01 lot,
# bounded by the daily-loss lock (3%) and the 10% drawdown latch.
KINGAI_MAX_POSITIONS_PER_SYMBOL=100
# Minimum seconds between entries on the same symbol (0 = no cooldown).
KINGAI_SYMBOL_COOLDOWN_SECONDS=300
KINGAI_MAX_LOT=0.01
KINGAI_LLM_REQUIRE_APPROVE=true

# Operator-authorized B9 override: breakout demo canary on XAUUSD only.
# Keep /tmp/vilona-STOP_ENTRIES active until the final launch check.
#KINGAI_STRATEGY=breakout
#KINGAI_BREAKOUT_LOOKBACK=20
#KINGAI_SL_ATR_MULT=1.5
#KINGAI_TP_ATR_MULT=3.0

KINGAI_STRATEGY=scalp_5m
KINGAI_SCALP_PULLBACK_BAND=1.5
KINGAI_SL_ATR_MULT=1.5
KINGAI_TP_ATR_MULT=6.0
