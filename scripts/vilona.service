[Unit]
Description=Vilona AI v2 Trading Agent
After=network-online.target vilona-mt5-mcp.service
Wants=network-online.target
Requires=vilona-mt5-mcp.service

[Service]
Type=simple
WorkingDirectory=/mnt/hermes-workspace/Apps/vilona-ai
EnvironmentFile=-/mnt/hermes-workspace/Apps/vilona-ai/.env
Environment=PYTHONUNBUFFERED=1
Environment="PATH=/mnt/hermes-workspace/Apps/vilona-ai/.venv/bin:/usr/bin:/bin"
ExecStart=/mnt/hermes-workspace/Apps/vilona-ai/.venv/bin/python app_server.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
